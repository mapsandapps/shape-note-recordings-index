---
import Layout from '../layouts/Layout.astro';
import LessonsList from '../components/embeds/LessonsList.astro';
import { db } from "../../db/db"; // adjust path

const NUMBER_OF_DAYS = 1;
const daysFilter = `-${NUMBER_OF_DAYS} days`

interface LessonWithDetails {
  singing: string;
  date: string;
  recordist: string;
  page: string;
  bookSlug: string;
  url: string;
  embedUrl: string | null;
  createdAt: string;
  tuneName: string;
  bookName: string;
  bookYear: string;
}

const lessons = db
  .prepare(
    `SELECT
       Recording.singing,
       Recording.date,
       Recording.recordist,
       Lesson.page,
       Lesson.bookSlug,
       Lesson.url,
       Lesson.embedUrl,
       Recording.createdAt,
       Page.tuneName,
       Book.name AS bookName,
       Book.year AS bookYear
     FROM Lesson
     INNER JOIN Book ON Book.slug = Lesson.bookSlug
     INNER JOIN Page ON Page.page = Lesson.page AND Page.bookSlug = Lesson.bookSlug
     INNER JOIN Recording ON Recording.id = Lesson.recordingId
     WHERE Recording.createdAt >= datetime('now', ?)
     ORDER BY Recording.createdAt DESC`,
  )
  .all(daysFilter) as unknown as LessonWithDetails[];
---

<Layout>
  <ul class="breadcrumbs">
    <li><a href="/">Home</a></li>
    <li>Recent additions</li>
  </ul>

  <h1>Recent Additions</h1>

  {lessons.length === 0 && (
    <p>No recordings added in the last {NUMBER_OF_DAYS} {NUMBER_OF_DAYS == 1 ? 'day' : 'days'}</p>
  )}

  <LessonsList lessons={lessons} shouldIncludePage />
</Layout>
