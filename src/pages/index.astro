---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
const bookImages = import.meta.glob('../assets/books/*.jpg', { eager: true });
import { db } from "../../db/db"; // adjust path
import type { Book } from '../data-collection-scripts/types';

const books = db
  .prepare(
    `SELECT *
     FROM Book
     ORDER BY Book.year DESC`,
  )
  .all() as unknown as Book[];

const booksWithImages = Object.entries(bookImages).map(([path, module]) => {
  const slug = path.split('/').pop()?.replace('.jpg', '');
  const info = books.find(b => b.slug === slug);

  if (!info) return;
  return {
    image: module.default,
    ...info,
  };
}).sort((a, b) => b!.year.localeCompare(a!.year));

//

// const booksWithImages = books.filter(book => bookSlugsWithImages.includes(book.slug));
const booksWithoutImages = books.filter(book => !booksWithImages.map(book => book!.slug).includes(book.slug));
---

<Layout>
  <h1>Index of Recordings from Shape Note Tune Books</h1>
  <div class="gallery">
    {booksWithImages.map(book => {
      if (!book) return;
      return (
        <div class="book-with-image">
          <a href={`/${book.slug}`}>
            <figure>
              <Image src={book.image} alt={book.name || "book"} />
              <figcaption>{book.name} ({book.year})</figcaption>
            </figure>
          </a>
        </div>
      )}
    )}
  </div>
  <ul>
    {booksWithoutImages.map(book => (
      <li><a href={`/${book.slug}`}>{book.name} ({book.year})</a></li>
    ))}
  </ul>
  <p>Or&hellip; view <a href="/all-pages">all pages from all books</a> or view <a href="/recent/7">recent additions</a></p>
</Layout>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(2, 200px);
    justify-content: center;
    gap: 16px;
    padding-bottom: 32px;
  }

  .book-with-image {
    display: inline-block;
    max-width: 200px;
    vertical-align: top;
  }

  img {
    max-width: 200px;
    height: auto;
  }

  figure {
    margin: 0px;
  }

  figcaption {
    width: 100%;
    text-align: center;
  }

  ul {
    padding-bottom: 3rem;
  }

  @media (max-width: 448px) {
    .gallery {
      grid-template-columns: repeat(1, 200px);
    }
  }
</style>
