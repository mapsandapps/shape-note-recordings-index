---
import Layout from '../../layouts/Layout.astro';
import LessonsList from '../../components/embeds/LessonsList.astro';
import { db } from "../../../db/db"; // adjust path
import type { Recording } from '../../data-collection-scripts/types';

export async function getStaticPaths() {
  return [
    { params: { days: '1' } },
    { params: { days: '7' } },
    { params: { days: '30' } },
  ]
}

const { days } = Astro.params;
const daysFilter = `-${days} days`

interface LessonWithDetails {
  singing: string;
  date: string;
  recordist: string;
  page: string;
  bookSlug: string;
  url: string;
  embedUrl: string | null;
  createdAt: string;
  tuneName: string;
  bookName: string;
  bookYear: string;
  recordingId: string;
}

const recordings = db
  .prepare(
    `SELECT *
     FROM Recording
     WHERE Recording.createdAt >= datetime('now', ?)
     ORDER BY Recording.createdAt DESC`
  )
  .all(daysFilter) as unknown as Recording[];

const lessons = db
  .prepare(
    `SELECT
       Recording.singing,
       Recording.date,
       Recording.recordist,
       Lesson.page,
       Lesson.bookSlug,
       Lesson.url,
       Lesson.embedUrl,
       Lesson.recordingId,
       Recording.createdAt,
       Page.tuneName,
       Book.name AS bookName,
       Book.year AS bookYear
     FROM Lesson
     INNER JOIN Book ON Book.slug = Lesson.bookSlug
     INNER JOIN Page ON Page.page = Lesson.page AND Page.bookSlug = Lesson.bookSlug
     INNER JOIN Recording ON Recording.id = Lesson.recordingId
     WHERE Recording.createdAt >= datetime('now', ?)
     ORDER BY Recording.createdAt DESC`,
  )
  .all(daysFilter) as unknown as LessonWithDetails[];

const lessonsByRecordingId = new Map();
for (const lesson of lessons) {
  if (!lessonsByRecordingId.has(lesson.recordingId)) {
    lessonsByRecordingId.set(lesson.recordingId, []);
  }
  lessonsByRecordingId.get(lesson.recordingId).push(lesson);
}

const recordingsWithLessons = recordings.map(recording => ({
  ...recording,
  lessons: lessonsByRecordingId.get(recording.id) ?? [],
}));
---

<Layout>
  <ul class="breadcrumbs">
    <li><a href="/">Home</a></li>
    <li>Recent additions</li>
  </ul>

  <h1>Recent Additions</h1>

  {lessons.length === 0 ? (
    <p>No recordings were ingested in the last {days} {Number(days) === 1 ? 'day' : 'days'}</p>
  ) : (
    <p>These recordings were ingested in the last {days} {Number(days) === 1 ? 'day' : 'days'}</p>
  )}

  <p>
    <a href="./1">View last 1 day</a><br />
    <a href="./7">View last 7 days</a><br />
    <a href="./30">View last 30 days</a>
  </p>

  {recordingsWithLessons.map(recording => (
    <details>
      <summary>{recording.singing}</summary>
      <LessonsList lessons={recording.lessons} shouldIncludePage />
    </details>
  ))}

</Layout>

<style>
  summary {
    margin-block-start: 1.66em;
    font-size: 1.5em;
    font-weight: bold;
  }
</style>
