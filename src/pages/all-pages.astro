---
import Layout from '../layouts/Layout.astro';
import { db } from "../../db/db"; // adjust path

interface PageWithBook {
  page: string;
  tuneName: string;
  bookSlug: string;
  bookName: string;
  bookYear: string;
}

const pages = db
  .prepare(
    `SELECT
       Page.page,
       Page.tuneName,
       Page.bookSlug,
       Book.name AS bookName,
       Book.year AS bookYear
     FROM Page
     INNER JOIN Book ON Book.slug = Page.bookSlug
     ORDER BY Page.tuneName ASC, Book.year DESC`,
  )
  .all() as unknown as PageWithBook[];
---

<Layout>
  <ul class="breadcrumbs">
    <li><a href="/">Home</a></li>
    <li>All tunes</li>
  </ul>

  <h1>Index of Tunes from Shape Note Tune Books</h1>
  <ul>
    {pages.map(page => (
      <li><a href={`/${page.bookSlug}/${page.page}`}>{page.tuneName}</a>, {page.bookName} ({page.bookYear}) pg. {page.page}</li>
    ))}
  </ul>
  <p>Or&hellip; view pages from all books</p>
</Layout>
