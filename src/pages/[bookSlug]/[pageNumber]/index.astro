---
import Layout from "../../../layouts/Layout.astro";
import { getNormalizedCurrentPage, NORMALIZED_TUNE_NAME_SQL } from "../../../utils/tune-name-comparisons";
import LessonsList from "../../../components/embeds/LessonsList.astro";
import { db } from "../../../../db/db";
import type { LessonDetail, Page, PageDetail } from "../../../data-collection-scripts/types";

export async function getStaticPaths() {
  const pages = db
    .prepare(`SELECT * FROM Page`)
    .all() as unknown as Page[];

  return pages.map((page) => ({
    params: {
      bookSlug: page.bookSlug,
      pageNumber: page.page,
    },
  }));
}

const { bookSlug, pageNumber } = Astro.params;

if (!bookSlug || !pageNumber) {
  return new Response(null, { status: 404 });
}

const page = db
  .prepare(
    `SELECT
       Page.page AS pageNumber,
       Page.tuneName,
       Page.bookSlug,
       Book.name AS bookName,
       Book.year AS bookYear
     FROM Page
     INNER JOIN Book ON Book.slug = Page.bookSlug
     WHERE Page.bookSlug = ? AND Page.page = ?`,
  )
  .get(bookSlug, pageNumber) as unknown as PageDetail | undefined;

if (!page) {
  return new Response(null, { status: 404 });
}

const lessons = db
  .prepare(
    `SELECT
       Lesson.id,
       Recording.singing,
       Recording.date,
       Recording.recordist,
       Lesson.url,
       Lesson.embedUrl
     FROM Lesson
     INNER JOIN Recording ON Recording.id = Lesson.recordingId
     WHERE Lesson.bookSlug = ? AND Lesson.page = ?
     ORDER BY Recording.date DESC, Lesson.id DESC`,
  )
  .all(page.bookSlug, pageNumber) as unknown as LessonDetail[];

// get other tunes with same name
const tunes = db
  .prepare(
    `SELECT
       Page.page,
       Page.tuneName,
       Page.bookSlug,
       Book.name AS bookName,
       Book.year AS bookYear
     FROM Page
     INNER JOIN Book ON Book.slug = Page.bookSlug
     WHERE (${NORMALIZED_TUNE_NAME_SQL}) = ?
       AND Page.bookSlug != ?
     ORDER BY Page.tuneName ASC, Book.name ASC, Book.year DESC`,
  )
  .all(getNormalizedCurrentPage(page), page.bookSlug) as unknown as PageDetail[];

const youTubeSearchLink = encodeURI(`https://www.youtube.com/results?search_query=${page.bookName} ${pageNumber}`);
---
<Layout title={`Recordings of ${page.page} ${page.tuneName}`}>
  <ul class="breadcrumbs">
    <li><a href="/">Home</a></li>
    <li><a href={`/${bookSlug}`}>{page.bookName}</a></li>
    <li>{page.page}</li>
  </ul>

  <h1>{page.bookName} ({page.bookYear}) &mdash; {page.page} {page.tuneName}</h1>

  {lessons.length === 0 && (
    <p>No recordings yet&hellip;</p>
  )}

  <LessonsList lessons={lessons} />

  <hr />
  <p>Note: The recordings collected on this site are mostly ones it's hard to search for. You may find additional recordings via a simple <a href={youTubeSearchLink} target="_blank">YouTube search</a>.</p>

  {tunes.length > 0 && (
    <hr />
    <h2>Same Tune Name In Other Books</h2>
  )}
  <ul>
    {tunes.map(tune => (
      <li><a href={`/${tune.bookSlug}/${tune.page}`}>{tune.tuneName}</a> {tune.bookName} ({tune.bookYear}), pg. {tune.page}</li>
    ))}
  </ul>
</Layout>

<style>
  .recording {
    padding-bottom: 4rem;
  }
</style>
