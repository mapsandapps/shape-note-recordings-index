---
import Layout from "../../../layouts/Layout.astro";
import LessonsList from "../../../components/embeds/LessonsList.astro";
import MultiEmbed from "../../../components/embeds/MultiEmbed.astro";
import { db } from "../../../../db/db";
import type { LessonDetail, Page, PageDetail } from "../../../data-collection-scripts/types";
import { fuzzySearchNames } from "../../../utils/fuzzy-search";

export async function getStaticPaths() {
  const pages = db
    .prepare(`SELECT * FROM Page`)
    .all() as unknown as Page[];

  return pages.map((page) => ({
    params: {
      bookSlug: page.bookSlug,
      pageNumber: page.page,
    },
  }));
}

const { bookSlug, pageNumber } = Astro.params;

if (!bookSlug || !pageNumber) {
  return new Response(null, { status: 404 });
}

const page = db
  .prepare(
    `SELECT
       Page.page,
       Page.tuneName,
       Page.bookSlug,
       Book.name AS bookName,
       Book.year AS bookYear
     FROM Page
     INNER JOIN Book ON Book.slug = Page.bookSlug
     WHERE Page.bookSlug = ? AND Page.page = ?`,
  )
  .get(bookSlug, pageNumber) as unknown as PageDetail | undefined;

if (!page) {
  return new Response(null, { status: 404 });
}

const lessons = db
  .prepare(
    `SELECT
       Lesson.id,
       Recording.singing,
       Recording.date,
       Recording.recordist,
       Lesson.url,
       Lesson.embedUrl
     FROM Lesson
     INNER JOIN Recording ON Recording.id = Lesson.recordingId
     WHERE Lesson.bookSlug = ? AND Lesson.page = ?
     ORDER BY Recording.date DESC, Lesson.id DESC`,
  )
  .all(page.bookSlug, pageNumber) as unknown as LessonDetail[];

const multiEmbedLessons = lessons.filter(lesson => lesson.embedUrl?.includes('archive.org'));

const pagesInOtherBooks: PageDetail[] = await fuzzySearchNames(page);

const youTubeSearchLink = encodeURI(`https://www.youtube.com/results?search_query=${page.bookName} ${pageNumber}`);
---
<Layout title={`Recordings of ${pageNumber} ${page.tuneName}`}>
  <ul class="breadcrumbs">
    <li><a href="/">Home</a></li>
    <li><a href={`/${bookSlug}`}>{page.bookName}</a></li>
    <li>{pageNumber}</li>
  </ul>

  <h1>{page.bookName} ({page.bookYear}) &mdash; {pageNumber} {page.tuneName}</h1>

  {lessons.length === 0 && (
    <p>No recordings yet&hellip;</p>
  )}

  {multiEmbedLessons.length > 0 && (
    <>
      <h2>Playlist of Tracks from Archive.org</h2>
      <MultiEmbed lessons={multiEmbedLessons} page={page} />
    </>
  )}

  <h2>All Recordings</h2>

  <LessonsList lessons={lessons} />

  <hr />
  <p>Note: The recordings collected on this site are mostly ones it's hard to search for. You may find additional recordings via a simple <a href={youTubeSearchLink} target="_blank">YouTube search</a>.</p>

  {pagesInOtherBooks.length > 0 && (
    <hr />
    <h2>Similar Tune Names In Other Books</h2>
  )}
  <ul>
    {pagesInOtherBooks.map(otherPage => {
      const link = <a href={`/${otherPage.bookSlug}/${otherPage.page}`}>{otherPage.tuneName}</a>
      const isNameSame = otherPage.tuneName.toLowerCase() === page.tuneName.toLowerCase();

      return (<li>{isNameSame ? <b>{link}</b> : link} ({otherPage.lessonsCount} {otherPage.lessonsCount === 1 ? 'recording' : 'recordings'}) {otherPage.bookName} ({otherPage.bookYear}), pg. {otherPage.page}</li>)
    })}
  </ul>
</Layout>

<style>
  .recording {
    padding-bottom: 4rem;
  }
</style>
