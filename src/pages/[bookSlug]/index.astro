---
import Layout from '../../layouts/Layout.astro';
import { db } from "../../../db/db";
import type { Book } from "../../data-collection-scripts/types";

interface BookSlug {
  slug: string;
}

export async function getStaticPaths() {
  const books = db
    .prepare(`SELECT slug FROM Book`)
    .all() as unknown as BookSlug[];

  return books.map((book) => ({
    params: {
      bookSlug: book.slug,
    },
  }));
}

const { bookSlug } = Astro.params;

const book = db
  .prepare(`SELECT slug, name, year FROM Book WHERE slug = ?`)
  .get(bookSlug) as unknown as Pick<Book, "slug" | "name" | "year"> | undefined;

if (!book) {
  return new Response(null, { status: 404 });
}

interface PageWithLessonInfo {
  page: string;
  tuneName: string;
  hasLesson: number; // SQLite has no boolean type — 0 or 1
  lessonsCount: number;
}

const pages = db
  .prepare(
    `SELECT
       Page.page,
       Page.tuneName,
       (COUNT(Lesson.id) > 0) AS hasLesson,
       COUNT(Lesson.id) AS lessonsCount
     FROM Page
     LEFT JOIN Lesson ON Lesson.page = Page.page AND Lesson.bookSlug = Page.bookSlug
     WHERE Page.bookSlug = ?
     GROUP BY Page.id
     ORDER BY Page.pageSort ASC`,
  )
  .all(book?.slug) as unknown as PageWithLessonInfo[];
---

<Layout title={`Index of Recordings from ${book.name} (${book.year})`}>
  <ul class="breadcrumbs">
    <li><a href="/">Home</a></li>
    <li>{book.name} ({book.year})</li>
  </ul>

  <h1>{book.name} ({book.year})</h1>

  {book.slug === 'sh-1936' && (
    <p>Note: My index for this book is not complete</p>
  )}

  {book.slug === 'cb-2012' && (
    <p>Note: Cooper Book songs from non-Cooper Book singings have not yet been divided by year of revision</p>
  )}

  <p></p>

  <button>Show pages without recordings</button>

  <ul id="pages" class="hide-empty-pages">
    {pages.map(page => {
      const recordingsPlural = page.lessonsCount === 1 ? "recording" : "recordings";

      if (page.hasLesson) return (
        <li><a href={`/${book.slug}/${page.page}`}>{page.page} {page.tuneName}</a> ({page.lessonsCount} {recordingsPlural})</li>
      )
      return (
        <li class="no-recordings"><a href={`/${book.slug}/${page.page}`}>{page.page} {page.tuneName}</a> ({page.lessonsCount} {recordingsPlural})</li>
      )}
    )}
  </ul>
</Layout>

<script>
  const pageList = document.getElementById('pages');
  const button = document.getElementsByTagName('button')[0];

  button.addEventListener('click', () => {
    pageList?.classList.toggle('hide-empty-pages');
    if (button.innerText === 'Show pages without recordings') {
      button.innerText = 'Hide pages without recordings'
    } else {
      button.innerText = 'Show pages without recordings'
    }
  })

</script>

<style>
#pages.hide-empty-pages {
  .no-recordings {
    display: none;
  }
}

.no-recordings,
.no-recordings a {
  color: dimgray;
  text-decoration-style: dashed;
}
</style>
