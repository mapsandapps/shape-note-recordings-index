---
import { db } from "../../../db/db";
import type { Book } from "../../data-collection-scripts/types";
import PagesList from "../../components/PagesList.astro";

interface BookSlug {
  slug: string;
}

export async function getStaticPaths() {
  const books = db
    .prepare(`SELECT slug FROM Book`)
    .all() as unknown as BookSlug[];

  return books.map((book) => ({
    params: {
      bookSlug: book.slug,
    },
  }));
}

const { bookSlug } = Astro.params;

const book = db
  .prepare(`SELECT * FROM Book WHERE slug = ?`)
  .get(bookSlug) as unknown as Book;

if (!book) {
  return new Response(null, { status: 404 });
}

interface PageWithLessonInfo {
  page: string;
  tuneName: string;
  hasLesson: number; // SQLite has no boolean type — 0 or 1
  lessonsCount: number;
}

const pages = db
  .prepare(
    `SELECT
       Page.page,
       Page.tuneName,
       (COUNT(Lesson.id) > 0) AS hasLesson,
       COUNT(Lesson.id) AS lessonsCount
     FROM Page
     LEFT JOIN Lesson ON Lesson.page = Page.page AND Lesson.bookSlug = Page.bookSlug
     WHERE Page.bookSlug = ?
     GROUP BY Page.id
     ORDER BY Page.tuneName ASC`,
  )
  .all(book?.slug) as unknown as PageWithLessonInfo[];
---

<PagesList book={book} pages={pages} href="./" />
